+
+test('a separator consuming the remaining raw budget still records unread text in that object or page', async () => {
+  for (const pages of [[['正文  \n'.repeat(8000), '遗漏正文']], [['正文  \n'.repeat(8000)], ['遗漏正文']]]) {
