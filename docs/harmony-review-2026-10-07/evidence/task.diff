+    assert.deepEqual(f.files(), ['selected.pdf'], 'native preview copy must be removed');
+    assert.deepEqual(f.calls.releases, f.calls.pages, 'every opened native page must be released');
+    assert.ok(f.calls.documentsReleased > 0);
+  } finally { f.cleanup(); }
+};
